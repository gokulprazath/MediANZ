# Copy to .env.local and fill in. Never commit real values.

# "mock" (default): in-memory sample data, no Supabase. "live": the real Supabase project.
NEXT_PUBLIC_DATA_MODE=mock

# Live mode only. Use the anon or publishable key; never the service role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional: Google Maps JavaScript API key (restrict it by HTTP referrer) and map id.
# Without a key the clinic finder shows the list only.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Optional, server-only: any Australian suburb or postcode in Find care (Places Text Search).
# GOOGLE_PLACES_API_KEY=

# Part B (server-only, never NEXT_PUBLIC_): the Python services from src/healthmcp.
# The browser reaches them only through /api/agents/..., which adds the user's token.
AGENT_SERVICE_URL=http://localhost:3108
DISCOVERY_SERVICE_URL=http://localhost:3109

# Optional: evaluator demo login ("Demo account" on the login page) in live mode.
# Demo sessions of the demo accounts skip the MFA step. DEMO_PASSWORD is server-only.
# NEXT_PUBLIC_DEMO_LOGIN=true
# DEMO_LOGIN_ENABLED=true
# DEMO_PASSWORD=
# Optional overrides: DEMO_PATIENT_EMAIL, DEMO_CLINICIAN_EMAIL, DEMO_RECEPTIONIST_EMAIL
