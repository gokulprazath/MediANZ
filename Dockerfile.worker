# The consult-notes worker, for the Vercel daemon "consult-worker" (vercel.json).
# A long-running loop: approved transcripts -> draft facts and key points.
# Configuration comes from the deployment's environment variables (never .env).
#   docker build -f Dockerfile.worker -t medianz-worker .
#   docker run --env-file .env medianz-worker        # local check
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.19 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# Dependencies first (cached while only the code changes), then the package.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
COPY config ./config
RUN uv sync --frozen --no-dev

RUN useradd --system --uid 10001 worker
USER worker

CMD ["/app/.venv/bin/python", "-m", "healthmcp.consult_notes.worker"]
