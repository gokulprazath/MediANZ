{
  "version": 1,
  "agents": {
    "patient-assistant": {
      "description": "Runs in the patient app as the signed-in patient (user mode).",
      "modes": ["user"],
      "servers": {
        "patient_record": [
          "get_approved_facts",
          "get_observations",
          "get_eligibility",
          "get_appointments",
          "log_note"
        ],
        "matching": [
          "get_patient_gp_preferences",
          "find_gp_candidates",
          "get_score_breakdown",
          "get_fees",
          "get_plan_coverage",
          "get_facility_review_summary",
          "log_note"
        ],
        "booking": [
          "get_available_slots",
          "hold_slot",
          "propose_booking",
          "propose_cancellation",
          "propose_reschedule",
          "get_proposal_status",
          "log_note"
        ]
      }
    },
    "clinical-doc-agent": {
      "description": "Background job after a patient approves a transcript (job mode).",
      "modes": ["job"],
      "servers": {
        "transcript": [
          "get_processing_eligibility",
          "get_transcript_windows",
          "search_transcript",
          "check_grounding",
          "log_note"
        ],
        "decision": [
          "decide_batch",
          "decide_yes_no",
          "decide_choice",
          "decide_score",
          "log_note"
        ],
        "extraction": [
          "extract_value",
          "save_draft_fact",
          "raise_open_item",
          "create_gp_query",
          "list_open_items",
          "get_clinician_preferences",
          "log_note"
        ],
        "patient_record": [
          "get_approved_facts",
          "get_observations",
          "get_eligibility",
          "get_appointments",
          "log_note"
        ]
      }
    },
    "research-job": {
      "description": "Scheduled jobs that refresh insurance coverage and clinic reviews (job mode).",
      "modes": ["job"],
      "servers": {
        "web_research": [
          "import_phio_dataset",
          "refresh_plan_coverage",
          "refresh_facility_reviews",
          "web_search",
          "web_extract",
          "log_note"
        ]
      }
    },
    "explainer": {
      "description": "Patient-facing explanations of matching scores and fees (user mode, read-only).",
      "modes": ["user"],
      "servers": {
        "matching": ["get_score_breakdown", "get_fees"]
      }
    },
    "extractor": {
      "description": "Transcript extraction job: drafts facts and open items, never approves or writes final facts (job mode).",
      "modes": ["job"],
      "servers": {
        "transcript": ["get_transcript_windows", "check_grounding"],
        "decision": ["decide_yes_no", "decide_choice", "decide_score"],
        "extraction": ["extract_value", "save_draft_fact", "list_open_items"]
      }
    },
    "insights": {
      "description": "Patient-facing health insights over approved facts (user mode, read-only plus GP-query approval request).",
      "modes": ["user"],
      "servers": {
        "patient_record": ["get_approved_facts", "get_observations", "get_appointments"],
        "matching": ["get_patient_gp_preferences"]
      }
    },
    "insurance": {
      "description": "Patient-facing insurance lookup: fees, coverage and allowlisted web research (user mode, read-only).",
      "modes": ["user"],
      "servers": {
        "matching": ["get_fees", "get_plan_coverage"],
        "web_research": ["web_search", "web_extract"]
      }
    },
    "booking": {
      "description": "Patient-facing booking helper: finds a free slot and prepares a booking proposal the patient confirms in the app (user mode, never books).",
      "modes": ["user"],
      "servers": {
        "matching": ["find_gp_candidates"],
        "booking": ["get_available_slots", "propose_booking"]
      }
    },
    "insights-writer": {
      "description": "Internal code-only writer used after the patient approves a GP query (job mode).",
      "modes": ["job"],
      "servers": {
        "extraction": ["create_gp_query"]
      }
    }
  }
}
