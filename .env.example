# Development project only. Values from the Supabase dashboard:
#   Project Settings -> API Keys      (URL, anon/publishable key, service_role/secret key)
#   Project Settings -> JWT Keys      (legacy JWT secret, only if the project still uses HS256)
#   Connect -> Session pooler         (DATABASE_URL, with your database password)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
JOB_TOKEN_SECRET=change-me-32-bytes-minimum
SMOKE_OLIVIA_PASSWORD=

JEV_API_URL=
JEV_API_KEY=
JEV_DOCS_PATH=

SLM_BASE_URL=
SLM_API_KEY=
SLM_MODEL=

TAVILY_API_KEY=
GOOGLE_PLACES_API_KEY=

ALLOWED_RESEARCH_DOMAINS=privatehealth.gov.au,data.gov.au,sunstate.example.com,harbourside.example.com,campuscover.example.com,wanderer.example.com

# Optional runtime settings (defaults shown)
# DATA_BACKEND=pg            # pg | fake (in-memory sample data, no database)
# AGENTS_CONFIG_PATH=config/agents.json
# MOCK_FIXTURES_DIR=tests/fixtures
# HOST=127.0.0.1
# LOG_LEVEL=INFO
# MAX_REQUEST_BYTES=262144
# RATE_LIMIT_PER_MINUTE=120

# Optional agent layer (LangGraph + MCP gateway). It needs an OpenAI-compatible
# chat model; without AGENT_LLM_MODEL (or SLM_MODEL) the endpoints return 503.
# AGENT_GATEWAY_URL=http://127.0.0.1:3100/mcp
# AGENT_GATEWAY_TIMEOUT_SECONDS=30
# AGENT_LLM_BASE_URL=
# AGENT_LLM_API_KEY=
# AGENT_LLM_MODEL=
# AGENT_LLM_TEMPERATURE=0
# AGENT_MAX_STEPS=8
# AGENT_ACTION_TTL_SECONDS=300
# AGENT_PORT=3108

# Optional MCP gateway: exposes all seven servers on one MCP endpoint.
# Upstream URLs default to http://127.0.0.1:<server port>/mcp.
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=3100
# GATEWAY_TIMEOUT_SECONDS=30
# GATEWAY_MAX_REQUEST_BYTES=262144
# GATEWAY_UPSTREAM_BOOKING_URL=http://127.0.0.1:3106/mcp
# GATEWAY_UPSTREAM_DECISION_URL=http://127.0.0.1:3102/mcp
# GATEWAY_UPSTREAM_EXTRACTION_URL=http://127.0.0.1:3103/mcp
# GATEWAY_UPSTREAM_MATCHING_URL=http://127.0.0.1:3105/mcp
# GATEWAY_UPSTREAM_PATIENT_RECORD_URL=http://127.0.0.1:3104/mcp
# GATEWAY_UPSTREAM_TRANSCRIPT_URL=http://127.0.0.1:3101/mcp
# GATEWAY_UPSTREAM_WEB_RESEARCH_URL=http://127.0.0.1:3107/mcp
